#!/bin/bash
# agent-mac-ops tmux persistence (lives on the remote at ~/.agent-mac-ops/; rendered +
# pushed by `./setup.sh remote`). Makes the dev session survive a reboot or power loss:
# windows, their directories, splits, recent scrollback and iTerm tab colors come back,
# and programs listed in TMUX_RESTORE_PROCESSES are relaunched in their panes.
#
#   tmux-persist.sh ensure <session> <dir>   create-or-keep the session; restore once per boot
#   tmux-persist.sh save                     snapshot now
#
# Built on tmux-resurrect, cloned by setup.sh into ~/.agent-mac-ops/ (not ~/.tmux/plugins,
# so a copy you manage with TPM is never touched) and loaded at runtime, so your own
# ~/.tmux.conf is never edited. Deliberately NOT tmux-continuum:
#   • its restore skips whenever ANY other tmux server is running — on a shared remote
#     another user's server always is, so it would never fire;
#   • its save timer rides the status bar, which iTerm's `tmux -CC` never draws.
# Instead the save loop runs inside your tmux server (per-user, no launchd, no GUI login
# needed; dies with the server), and restore is explicit — see ensure below.
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH

RESURRECT="$HOME/.agent-mac-ops/tmux-resurrect"
SAVE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
MARKER="$SAVE_DIR/.amo-restored"   # mtime = when this boot's restore decision was made
COLORS="$SAVE_DIR/amo-tab-colors"  # session<TAB>window.pane<TAB>iTerm color, from the last save
SELF="$HOME/.agent-mac-ops/tmux-persist.sh"
INTERVAL_MIN="@@TMUX_SAVE_INTERVAL@@"
case "$INTERVAL_MIN" in ''|*[!0-9]*|0*) INTERVAL_MIN=15 ;; esac   # 0* also catches octal-looking 08/09
PROCESSES='@@TMUX_RESTORE_PROCESSES@@'

load() {  # idempotent: options + resurrect's key bindings (prefix C-s save, prefix C-r restore)
  [ -f "$RESURRECT/resurrect.tmux" ] || return 1
  # Pin the save dir: resurrect otherwise prefers ~/.tmux/resurrect when that exists (or a
  # user's own @resurrect-dir), and the restore check below would never find `last`.
  tmux set -g @resurrect-dir "$SAVE_DIR"
  tmux set -g @resurrect-capture-pane-contents on
  tmux set -g @resurrect-processes "$PROCESSES"
  tmux set -g @resurrect-hook-post-save-all "'$SELF' colors-save"
  tmux set -g @resurrect-hook-post-restore-all "'$SELF' colors-restore"
  tmux run-shell "$RESURRECT/resurrect.tmux"
}

# iTerm's tmux integration keeps tab colors in the session option @tab_colors: "t_" + hex of
# "<pane id>=<color> ...", pane ids without the %. resurrect doesn't save user options, and
# pane ids are renumbered on restore, so store colors by window.pane and translate back.
# Runs from resurrect's post-save / post-restore hooks, so prefix C-s / C-r carry them too.
colors_save() {
  local tmp="$COLORS.tmp" s v
  : > "$tmp"
  for s in $(tmux list-sessions -F '#{session_name}'); do
    v=$(tmux show -t "$s" -v @tab_colors 2>/dev/null); [ "${v#t_}" != "$v" ] || continue
    { printf '%s' "${v#t_}" | xxd -r -p; echo; } | tr ' ' '\n' | while IFS='=' read -r id color; do
      [ -n "$color" ] && [ "$color" != none ] || continue
      pos=$(tmux display -p -t "%$id" '#{window_index}.#{pane_index}' 2>/dev/null) || continue
      printf '%s\t%s\t%s\n' "$s" "$pos" "$color" >> "$tmp"
    done
  done
  mv "$tmp" "$COLORS"
}

colors_restore() {
  [ -s "$COLORS" ] || return 0
  local s pos color id cur
  for s in $(cut -f1 "$COLORS" | sort -u); do
    tmux has-session -t "=$s" 2>/dev/null || continue
    cur=$(tmux show -t "$s" -v @tab_colors 2>/dev/null); cur=$(printf '%s' "${cur#t_}" | xxd -r -p 2>/dev/null)
    while IFS=$'\t' read -r ss pos color; do
      [ "$ss" = "$s" ] || continue
      id=$(tmux display -p -t "=$s:$pos" '#{pane_id}' 2>/dev/null) || continue; id=${id#%}
      cur=$(printf '%s' "$cur" | tr ' ' '\n' | grep -v "^$id=" | tr '\n' ' ')"$id=$color"
    done < "$COLORS"
    cur=$(printf '%s' "$cur" | tr -s ' ' | sed 's/^ //; s/ $//')
    tmux set -t "$s" @tab_colors "t_$(printf '%s' "$cur" | xxd -p | tr -d '\n')"
  done
}

start_save_loop() {  # one loop per server; the server option dies with the server
  [ "$(tmux show -gv @amo-persist-loop 2>/dev/null)" = 1 ] && return
  tmux run-shell -b "while sleep $((INTERVAL_MIN * 60)); do tmux has-session 2>/dev/null || exit 0; '$RESURRECT/scripts/save.sh' quiet; done" \
    && tmux set -g @amo-persist-loop 1
}

# Restore at most once per boot. A missing tmux server alone doesn't mean the Mac
# restarted — kill-server or closing the last window stops it too, and restoring then
# would resurrect windows you just closed. Compare against the kernel's boot time.
restored_this_boot() {
  local boot; boot=$(sysctl -n kern.boottime 2>/dev/null | sed -E 's/^[{] sec = ([0-9]+),.*/\1/')
  [ -e "$MARKER" ] || return 1
  case "$boot" in ''|*[!0-9]*) return 0 ;; esac   # unreadable boot time: never re-restore
  [ "$(stat -f %m "$MARKER")" -ge "$boot" ]
}

lock() {  # two tabs connecting at once after a reboot must not both restore
  local i=0
  until mkdir "$SAVE_DIR/.amo-lock" 2>/dev/null; do
    # a lock older than 2 min is left over from a killed run
    [ -n "$(find "$SAVE_DIR/.amo-lock" -maxdepth 0 -mmin +2 2>/dev/null)" ] && rmdir "$SAVE_DIR/.amo-lock" 2>/dev/null
    i=$((i + 1)); [ $i -ge 150 ] && return 0; sleep 0.2
  done
  trap 'rmdir "$SAVE_DIR/.amo-lock" 2>/dev/null' EXIT
}

case "${1:-}" in
  ensure)
    session="${2:?session}"; dir="${3:-$HOME}"
    mkdir -p "$SAVE_DIR"; lock
    if tmux has-session -t "$session" 2>/dev/null; then
      restored_this_boot || touch "$MARKER"   # already up: nothing to bring back this boot
      load && start_save_loop
      exit 0
    fi
    tmux new-session -d -s "$session" -c "$dir"
    if load; then
      if ! restored_this_boot; then
        # Synchronous, so an attaching `tmux -CC` client never races window creation.
        # Restoring into the just-created session replaces its blank first window.
        [ -e "$SAVE_DIR/last" ] && tmux run-shell "$RESURRECT/scripts/restore.sh"
        touch "$MARKER"
      fi
      start_save_loop
    fi ;;
  save)
    load && tmux run-shell "$RESURRECT/scripts/save.sh quiet" ;;
  colors-save)    colors_save ;;
  colors-restore) colors_restore ;;
  *) echo "usage: tmux-persist.sh ensure <session> <dir> | save" >&2; exit 2 ;;
esac
